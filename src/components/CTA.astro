---
import { photo, images } from '../data';
---

<section class="cta" id="commissions">
  <div class="cta-texture" aria-hidden="true">
    <img src={photo(images.laserLiverpool, 1600)} width="1600" height="900" loading="lazy" alt="" />
  </div>
  <div class="wrap cta-inner">
    <h2 class="reveal">Have something in mind?</h2>
    <p class="reveal" style="--reveal-delay: 90ms">
      Email me or send a DM on Instagram. We talk through what you want made, I
      send an honest estimate for cost and time, and once you&rsquo;re happy I
      start the work.
    </p>
    <div class="cta-actions reveal" style="--reveal-delay: 170ms">
      <div class="cta-buttons">
        <a href="mailto:dino@craftasaurusrex.com?subject=Commission" class="btn">
          Start a commission
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href="https://www.instagram.com/craftasaurusrex/" target="_blank" rel="noopener"
          class="arrow-link cta-dm">
          or DM me on Instagram
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
      <span class="cta-note">Commissions are open now.</span>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: oklch(0.95 0.006 70);
    background: oklch(0.2 0.014 48);
    padding-block: clamp(3.25rem, 6.5vw, 5.5rem);
  }
  .cta-texture {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.24;
  }
  .cta-texture img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.7); }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, oklch(0.2 0.014 48 / 0.7), oklch(0.16 0.014 46 / 0.92)),
      radial-gradient(70% 80% at 80% 20%, var(--glow), transparent 60%);
  }

  .cta-inner {
    max-width: 44rem;
    text-align: center;
    margin-inline: auto;
  }
  .cta-inner h2 {
    font-size: clamp(2.3rem, 5.2vw, 4rem);
    margin: 0;
    color: oklch(0.98 0.005 75);
  }
  .cta-inner p {
    margin: 1.25rem auto 0;
    max-width: 46ch;
    font-size: 1.15rem;
    color: oklch(0.86 0.01 70);
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2.25rem;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.75rem;
  }
  .cta-dm {
    color: oklch(0.9 0.008 70);
    transition: color 0.2s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .cta-dm:hover { color: var(--ember-hot); }
  }
  .cta-note {
    font-size: 0.9rem;
    color: oklch(0.78 0.012 68);
  }
</style>
